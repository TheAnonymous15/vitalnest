# VitalNest Admin Dashboard - URL Rewriting
# Enable clean URLs without .php extensions

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect if .php extension is in URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # Route /login to components/login.php
    RewriteRule ^login$ components/login.php [L]

    # Route /dashboard to components/dashboard.php
    RewriteRule ^dashboard$ components/dashboard.php [L]

    # If file doesn't exist, try adding .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]

    # Deny direct access to components folder (optional security)
    # RewriteRule ^components/ - [F,L]
</IfModule>

# Security: Prevent directory browsing
Options -Indexes

# Security: Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
